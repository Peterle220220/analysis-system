# Copy sang .env roi sua. File .env KHONG BAO GIO duoc commit (.gitignore da chan).

# --- Noi luu du lieu -----------------------------------------------------------
# Mac dinh: ~/analysis-data va ~/analysis-runs.
# Tro sang o dia khac chi can doi hai bien nay, khong sua config/settings.yaml.
ANALYSIS_DATA=/srv/analysis-data
ANALYSIS_RUNS=/srv/analysis-runs

# --- File cau hinh ---------------------------------------------------------------
# Bo trong de dung config/settings.yaml trong repo.
# ANALYSIS_SYSTEM_CONFIG=/etc/analysis-system/settings.yaml

# --- Khoa API ----------------------------------------------------------------------
# CHI can khi llm.provider = anthropic. Cac provider khac (handoff, cassette,
# none) khong goi API va khong ton tien.
# ANTHROPIC_API_KEY=sk-ant-...
